# Sao chép tệp này thành ".env" rồi điền giá trị thật. KHÔNG commit tệp .env, KHÔNG chia sẻ ảnh chụp của nó.

# ---- Đăng nhập ----
# Cách an toàn nhất: để trống NEO_USERNAME và NEO_PASSWORD. Khi chạy, chương trình sẽ hỏi trên dòng lệnh
# (mật khẩu không hiển thị khi gõ), lấy token và chỉ giữ trong bộ nhớ.
# Nếu điền ở đây thì mật khẩu tài khoản chứng khoán nằm dạng chữ thường trong tệp: chỉ làm trên máy cá nhân.
NEO_USERNAME=
NEO_PASSWORD=
# Tùy chọn: dán token đang còn hạn để chạy thử nhanh. Token hết hạn thì chương trình tự đăng nhập lại.
NEO_API_TOKEN=

# ---- Địa chỉ (theo tài liệu và ví dụ NEO; thường không cần sửa) ----
NEO_AUTH_URL=https://external.vpbanks.com.vn/auth/token
NEO_BASE_URL=https://neoapi.vpbanks.com.vn/neo-api
# Tài liệu ghi ws:// (không mã hóa), token gửi trong tin nhắn xác thực. Thử wss:// nếu NEO hỗ trợ; tránh wifi công cộng.
NEO_WS_URL=ws://neoapi.vpbanks.com.vn/stock-stream/broker
# Header bắt buộc theo ví dụ của NEO.
NEO_DEVICE=my-app
NEO_DEVICE_TYPE=chrome

# Giới hạn REST của NEO: 5 yêu cầu/giây cho mỗi máy khách (WebSocket chưa công bố giới hạn).
NEO_MAX_RPS=5

# ---- Ghi dữ liệu ----
# Mỗi bao nhiêu giây chụp sổ lệnh một lần, và bao lâu không có tin mới thì ngừng chụp mã đó.
NEO_SNAPSHOT_SECONDS=60
NEO_STALE_SECONDS=900
# Nơi lưu dữ liệu đã ghi (SQLite).
NEO_DB_PATH=data/market.db

#API SSI
SSI_API_KEY=
SSI_API_SECRET=